// Cloudflare Worker "captains-chest-site": Angular SSR at the edge plus static assets.
// Deploy: pnpm build && pnpm exec wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "captains-chest-site",
  "main": "dist/site/server/server.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/site/browser",
    "binding": "ASSETS",
    // The Worker sees every request first, so it can redirect www, block *.md and set headers.
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none",
  },
  "alias": { "xhr2": "./worker/xhr2-stub.mjs" },
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  // Public hostnames. Former subdomains 301 to a path on the apex in src/server.ts.
  "routes": [
    { "pattern": "captains-chest.com", "custom_domain": true },
    { "pattern": "www.captains-chest.com", "custom_domain": true },
    { "pattern": "dictator.captains-chest.com", "custom_domain": true },
    { "pattern": "play.captains-chest.com", "custom_domain": true },
    { "pattern": "school.captains-chest.com", "custom_domain": true },
  ],
  // `wrangler preview` refuses to run without this block. Assets and compatibility stay at the top level.
  "previews": {},
  // Workers Builds does not read this as its build step, but `wrangler preview` and `wrangler deploy` do.
  // Skip when CI or a local build already wrote the Worker entry.
  "build": {
    "command": "test -f dist/site/server/server.mjs || pnpm run build",
    "watch_dir": "worker",
  },
}
