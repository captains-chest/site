{
  "name": "captains-chest-site",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/generate-skills.mjs && ng build && node scripts/fix-csp-html.mjs && rm -f dist/site/browser/index.csr.html",
    "watch": "ng build --watch --configuration development",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "pnpm run build && wrangler dev",
    "check:axe": "node scripts/ci/axe.mjs",
    "check:navigation": "node scripts/ci/navigation.mjs",
    "check:html": "java -jar node_modules/vnu-jar/build/dist/vnu.jar --errors-only --filterpattern \".*Attribute “(ngh|ngb|jsaction|routerlink|routerlinkactive|ariacurrentwhenactive|fragment|cc-[a-z-]+|msriconsvg|ng-app-id|_ngcontent-ng-c[0-9]+)” not allowed.*\" --skip-non-html dist/site/browser dist/site/server/index.server.html",
    "check:lighthouse": "lhci autorun --config=lighthouserc.mobile.json && lhci autorun --config=lighthouserc.desktop.json",
    "content": "node scripts/generate-skills.mjs",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint",
    "check": "vp check"
  },
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/ssr": "^22.2.4",
    "@captains-chest/material-symbols-rounded-icons": "^3.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@lhci/cli": "~0.15.1",
    "@types/node": "^26.6.5",
    "axe-core": "^4.14.0",
    "marked": "^18.1.1",
    "puppeteer-core": "^25.16.0",
    "typescript": "~6.0.2",
    "vite-plus": "catalog:",
    "vnu-jar": "^26.10.12",
    "wrangler": "^4.152.0"
  }
}
