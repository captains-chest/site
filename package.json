{
  "name": "captains-chest-site",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && rm -f dist/site/browser/index.csr.html",
    "watch": "ng build --watch --configuration development",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "pnpm run build && wrangler dev",
    "check:axe": "node scripts/ci/axe.mjs",
    "check:html": "java -jar node_modules/vnu-jar/build/dist/vnu.jar --errors-only --filterpattern \".*Attribute “(ngh|jsaction|routerlink|routerlinkactive|ariacurrentwhenactive|fragment|cc-[a-z-]+)” not allowed.*\" dist/site/browser/index.html dist/site/server/index.server.html",
    "check:lighthouse": "lhci autorun --config=lighthouserc.mobile.json && lhci autorun --config=lighthouserc.desktop.json"
  },
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@lhci/cli": "~0.15.1",
    "@types/node": "^22.12.0",
    "axe-core": "^4.14.0",
    "prettier": "^3.8.1",
    "puppeteer-core": "^25.13.0",
    "typescript": "~6.0.2",
    "vnu-jar": "^26.10.9",
    "wrangler": "^4.149.0"
  }
}
